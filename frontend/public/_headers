# Cloudflare Pages response headers.
#
# Cloudflare already sets X-Content-Type-Options and Referrer-Policy on this
# project; these add the two protections that were genuinely missing.
#
# Deliberately NOT setting a Content-Security-Policy here. The app loads its
# typeface from Google Fonts and ships inline styles, so a CSP is a real
# change that needs to be authored and verified against the built bundle
# rather than added blind — see the Legal & Trust checkpoint report.

/*
  # The demo has no reason to be framed by another site; this removes
  # clickjacking as a concern outright.
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  # Kynd asks for none of these, so no embedded content can either.
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  # Belt and braces alongside Cloudflare's own default.
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
